// ─────────────────────────────────────────────────────────────
// Contoh escape hatch `@sv { ... }` — sisipkan SystemVerilog mentah
// (verbatim) untuk konstruk yang belum didukung bahasa .mv:
//   - assertion concurrent SVA (`|->`, `disable iff`) — operatornya
//     bukan token .mv, jadi diekstrak ke `@sv`.
//   - `$monitor` prosedural.
// Body `@sv` diambil mentah dari source oleh lexer (isolasi dari token
// .mv), sehingga karakter apa pun lolos. Type-check & codegen melewatinya.
// ─────────────────────────────────────────────────────────────

module escape_dut {
    in  clk, rst_n : bit
    in  inc        : bit
    out count      : logic[7:0]

    reg count : logic[7:0] = '0

    seq(clk, rst_n) {
        if (!rst_n) {
            count <= '0
        } else if (inc) {
            count <= count + 1
        }
    }
}

module tb_escape {
    sig clk, rst_n : bit
    sig inc        : bit
    sig count      : logic[7:0]

    inst escape_dut u_dut (.clk(clk), .rst_n(rst_n), .inc(inc), .count(count))

    // Concurrent assertion = MODULE ITEM (LRM 1800 §14), bukan statement
    // di dalam `initial` — operator SVA `|->`/`disable iff` bukan token
    // `.mv` jadi body-nya dipertahankan raw dan di-emit 1:1.
    assert property (@(posedge clk) disable iff (rst_n == 0) inc |-> $past(count) + 1'b1 == count)

    initial {
        // escape hatch: sisipkan SV mentah verbatim
        @sv {
            // $display prosedural sekali (isi @sv bebas menulis `;`)
            $display("ESCAPE_SVH_DISPLAY t=%0t", $time);
        }

        clk   = 0
        rst_n = 0
        inc   = 0
        #30
        rst_n = 1
        inc   = 1
        repeat (5) @(posedge clk)
        $display("TB_ESCAPE_OK count=%0d", count)
        $finish
    }

    // clock generator (signal internal TB — pola resmi tb_counter.mv)
    initial {
        forever #5 clk = ~clk
    }
}

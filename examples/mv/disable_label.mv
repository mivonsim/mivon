// F47 — `label : { ... }` (blok bernama) + `disable <label>` lintas branch fork.
//
// EKSTENSI MIVON (di luar LRM 1800). `disable <label>` di LRM hanya berlaku
// untuk blok bernama yang MENGELILINGI statement itu (LRM 1800 §9.6.4) — jadi
// `disable worker` dari branch fork yang SAUDARA tidak sah di SV standar, dan
// verilator menolaknya:
//
//     %Error: disable isn't underneath a begin with name: 'worker'
//
// Mivon mengimplementasikan bentuk yang lebih berguna: `disable <label>`
// boleh menembak blok bernama yang sedang berjalan di branch lain, dan hanya
// blok target yang mati — pelaku `disable` LANJUT sampai `join`.
// Untuk kode yang harus jalan di tool EDA lain, gunakan pola LRM-legal
// `disable fork` (menghentikan semua child) — lihat `examples/mv/fork_ctrl.mv`.
//
// Jalankan (transpile on-the-fly, tanpa menulis file):
//   mivon examples/mv/disable_label.mv --top tb_dl -T 50
// Expected: a=0 (worker dibunuh sebelum #10), done=1 (join selesai normal).

module tb_dl {
    sig a : logic[7:0] = '0
    sig done : bit = 0

    initial {
        fork {
            worker : {
                #10
                a = 1
            }
        } {
            #5
            disable worker
        } join
        done = 1
        $display("F47_DISABLE_LABEL a=%0d done=%0d", a, done)
        $finish
    }
}

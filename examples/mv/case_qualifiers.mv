// case_qualifiers.mv — priority case + wildcard
// Fitur: F26 (case qualifiers) + §6.6 (case statement)

module case_qualifiers {
    in  clk, rst_n : bit
    in  sel : logic[2:0]
    in  data_in : logic[7:0]
    out result : logic[7:0]

    reg result : logic[7:0] = '0

    // priority case — prioritas tertinggi di atas
    seq(clk, rst_n) {
        if (!rst_n) {
            result <= '0
        } else {
            priority case (sel) {
                3'b1?? : result <= data_in
                3'b01? : result <= data_in + 1
                3'b001 : result <= data_in + 2
                default : result <= '0
            }
        }
    }
}

module tb_caseq {
    sig clk, rst_n : bit
    sig sel : logic[2:0]
    sig data_in : logic[7:0]
    sig result : logic[7:0]

    inst case_qualifiers u_dut (.clk, .rst_n, .sel, .data_in, .result)

    initial {
        clk = 0
        forever #5 clk = ~clk
    }

    initial {
        rst_n = 0
        sel = 0
        data_in = 8'h10
        #20
        rst_n = 1

        // test priority case
        sel = 3'b101
        @(posedge clk)
        #1
        if (result != 8'h10) $error("priority case failed: result=%0h", result)

        sel = 3'b011
        @(posedge clk)
        #1
        if (result != 8'h11) $error("priority case arm2 failed: result=%0h", result)

        sel = 3'b001
        @(posedge clk)
        #1
        if (result != 8'h12) $error("priority case arm3 failed: result=%0h", result)

        sel = 3'b000
        @(posedge clk)
        #1
        if (result != 8'h00) $error("priority case default failed: result=%0h", result)

        $display("CASEQ_OK result=%0h", result)
        $finish
    }
}

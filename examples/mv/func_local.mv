// F34: function .mv dengan variabel lokal ber-initializer + return bekerja penuh.
// `func clog2` memakai `int r = 0; int n = x - 1;` (local init) + `return r;`
// (loop while). Sebelum fix F34: init local diabaikan saat inline → temp X →
// o = 0 (silent). Kini init di-emit ke temp signal → hasil benar.
func clog2(x : int) -> int {
    var r : int = 0
    var n : int = x - 1
    while (n > 0) {
        r = r + 1
        n = n >> 1
    }
    return r
}

// Function dgn init yang mereferensikan port (bukan literal).
// Nama `scale` dipakai `features_new.mv` juga — dua function level file
// dengan nama sama akan di-emit ke scope FILE SV yang sama dan ditolak
// tool EDA ("Duplicate declaration of function"), jadi E2007.
func dbl(v : int) -> int {
    var w : int = v * 2
    return w
}

module func_dut {
    in  a : logic[15:0]
    out o : logic[3:0]
    out s : logic[15:0]
    comb {
        o = clog2(a)
        s = dbl(a[7:0])
    }
}

module tb_fl {
    sig a : logic[15:0]
    sig o : logic[3:0]
    sig s : logic[15:0]
    inst func_dut u (.a(a), .o(o), .s(s))
    initial {
        a = 16'h0100
        #1
        $display("TB_FL o=%0d s=%0d", o, s)
    }
}

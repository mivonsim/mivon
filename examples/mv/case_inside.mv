// ─────────────────────────────────────────────────────────────
// Contoh Mivon HDL (.mv) — case inside: nilai + rentang (F70).
// Generate: mivon mgen case_inside.mv
// Sim: mivon case_inside.mv --top tb_ci -T 50
// ─────────────────────────────────────────────────────────────

module ci_dut {
    in sel : logic[7:0]
    out y : logic[7:0]

    comb {
        case (sel) inside {
            0 : { y = 8'h00 }
            [1:10] : { y = 8'h0A }
            [11:20], 30 : { y = 8'h14 }
            default : { y = 8'hFF }
        }
    }
}

module tb_ci {
    sig sel : logic[7:0]
    sig y : logic[7:0]
    inst ci_dut u (.sel(sel), .y(y))

    initial {
        sel = 0
        #1
        assert (y == 8'h00) $info("v0 ok") else $error("v0 bad")
        sel = 5
        #1
        assert (y == 8'h0A) $info("range ok") else $error("range bad")
        sel = 30
        #1
        assert (y == 8'h14) $info("multi ok") else $error("multi bad")
        sel = 99
        #1
        assert (y == 8'hFF) $info("def ok") else $error("def bad")
        $display("CASE_INSIDE_OK y=%0h", y)
        $finish
    }
}
